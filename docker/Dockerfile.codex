FROM python:3.14-slim

RUN useradd --create-home --uid 10001 reviewer
WORKDIR /app
RUN pip install --no-cache-dir "jsonschema>=4.25,<5"
COPY src /app/src
RUN mkdir -p /mailbox/inbox /mailbox/outbox /work/home /work/state /auth \
    && chown -R 10001:10001 /mailbox /work /auth
ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/work/home
USER 10001:10001
ENTRYPOINT ["python", "-m", "peer_reviewer.worker", "--provider", "codex"]
