{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "round_no", "reviewer", "input_state_hash", "review_complete", "new_issues", "proposals", "positions"],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "minLength": 1},
    "round_no": {"type": "integer", "minimum": 1},
    "reviewer": {"enum": ["A", "B"]},
    "input_state_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review_complete": {"const": true},
    "new_issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
    "positions": {"type": "array", "items": {"$ref": "#/$defs/position"}}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_start", "line_end", "quote"],
      "properties": {
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "quote": {"$ref": "#/$defs/nonempty"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "author", "anchor", "problem", "significance", "reasoning", "suggested_fix"],
      "properties": {
        "id": {"type": "string", "pattern": "^[AB]-[1-9][0-9]*$"},
        "author": {"enum": ["A", "B"]},
        "anchor": {"$ref": "#/$defs/anchor"},
        "problem": {"$ref": "#/$defs/nonempty"},
        "significance": {"$ref": "#/$defs/nonempty"},
        "reasoning": {"$ref": "#/$defs/nonempty"},
        "suggested_fix": {"$ref": "#/$defs/nonempty"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "fix", "resolution", "rationale", "duplicate_of", "closes"],
      "properties": {
        "problem": {"$ref": "#/$defs/nonempty"},
        "fix": {"type": "string"},
        "resolution": {"enum": ["accepted", "rejected", "duplicate"]},
        "rationale": {"$ref": "#/$defs/nonempty"},
        "duplicate_of": {"type": ["string", "null"], "pattern": "^[AB]-[1-9][0-9]*$"},
        "closes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_ref", "issue_id", "payload"],
      "properties": {
        "local_ref": {"$ref": "#/$defs/nonempty"},
        "issue_id": {"type": "string", "pattern": "^[AB]-[1-9][0-9]*$"},
        "payload": {"$ref": "#/$defs/payload"}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "action", "version_ref", "argument_id", "reason", "responds_to", "evidence"],
      "properties": {
        "issue_id": {"type": "string", "pattern": "^[AB]-[1-9][0-9]*$"},
        "action": {"enum": ["accept", "oppose", "propose"]},
        "version_ref": {"type": "string", "minLength": 1},
        "argument_id": {"type": "string", "pattern": "^[AB]-r[1-9][0-9]*-[1-9][0-9]*$"},
        "reason": {"$ref": "#/$defs/nonempty"},
        "responds_to": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[AB]-r[1-9][0-9]*-[1-9][0-9]*$"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/anchor"}}
      }
    }
  }
}
